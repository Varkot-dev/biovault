# Copy to .env and fill in. NEVER commit .env.
#
# Generate fresh secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # JWT secret
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"  # master KEK

# --- Database ---------------------------------------------------------------
# Superuser connection, used ONLY by migrations and RLS setup.
POSTGRES_USER=biovault_owner
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=biovault
# Hostname of the database as seen by whatever is connecting.
#
# `db` is the service name on the Compose network and is what the API
# container must use -- `docker compose up` will not start otherwise.
#
# Running the test suite or scripts from your host instead? Override it for
# that command only, rather than editing this file:
#
#     POSTGRES_HOST=localhost pytest tests/ -q
#
# Compose loads .env into the service environment and it takes precedence over
# the compose file's own `environment:` block, so setting `localhost` here
# silently breaks the containerized path with "failed to resolve host 'db'".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Least-privilege runtime role. RLS is NOT enforced for superusers or table
# owners, so the API must connect as this non-owning role or tenant isolation
# silently degrades to application-layer-only.
BIOVAULT_APP_DB_USER=biovault_app
BIOVAULT_APP_DB_PASSWORD=change-me-in-real-deployments

# --- Encryption at rest -----------------------------------------------------
# Base64-encoded 32-byte (256-bit) master key-encryption key. Wraps per-dataset
# data keys. In production this belongs in a real KMS/HSM, not an env var.
BIOVAULT_MASTER_KEK=
# Identifier for the active KEK. Bump when rotating; see docs/key-rotation.md.
BIOVAULT_MASTER_KEK_ID=kek-1

# --- JWT --------------------------------------------------------------------
BIOVAULT_JWT_SECRET=
BIOVAULT_JWT_ISSUER=https://biovault.local
BIOVAULT_JWT_AUDIENCE=biovault-api
BIOVAULT_ACCESS_TOKEN_TTL_SECONDS=900
BIOVAULT_REFRESH_TOKEN_TTL_SECONDS=604800

# --- OAuth 2.0 --------------------------------------------------------------
BIOVAULT_OAUTH_CLIENT_ID=biovault-web
BIOVAULT_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Runtime ----------------------------------------------------------------
BIOVAULT_ENV=development
BIOVAULT_RATE_LIMIT=100/minute
